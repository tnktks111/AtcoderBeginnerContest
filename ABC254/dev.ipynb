   "source": [
    "square_list = [1, 4, 9, 16, 25, 36]\n",
    "def nibutan(n:int) -> int:\n",
    "    l, r = 0, len(square_list) - 1\n",
    "    while (r - l > 1):\n",
    "        m = (l + r) // 2\n",
    "        if square_list[m] <= n:\n",
    "            l = m\n",
    "        else:\n",
    "            r = m\n",
    "    return l + 1\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "metadata": {},
